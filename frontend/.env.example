# Copy to .env.local for local development. On your host, set the same names in its environment settings.
NEXT_PUBLIC_API_URL=http://localhost:4000
# NEXT_PUBLIC_SITE_URL=https://www.yourstore.com

# ---- Error tracking (Sentry) — optional, see docs/OPERATIONS.md ----
# Create a second free Sentry project (platform: Next.js) and paste its DSN. Leave blank to turn tracking off.
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=production

# ---- Analytics (Google Analytics 4) — optional, see docs/ANALYTICS.md ----
# Measurement ID from analytics.google.com (looks like G-ABC123XYZ). Blank = no tracking and no cookie notice.
# NEXT_PUBLIC_GA_ID=
