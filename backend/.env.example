PORT=4000
FRONTEND_URL=http://localhost:3000
MONGODB_URI=your-mongodb-atlas-connection-string-here


JWT_SECRET=replace-with-a-long-random-string
NODE_ENV=development

# Admin account created/promoted by `npm run seed` or `npm run make-admin`.
# Leave blank to skip. Use your own strong password (8+ characters) and don't commit the real one.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Aurelia Admin

# Number of reverse proxies in front of the app (e.g. 1 on Render / Heroku / behind nginx).
# Needed so the login/register rate limit sees each visitor's real IP. Leave unset if not behind a proxy.
# TRUST_PROXY=1

# ---- Product image storage (Cloudinary) ----
# Required in production: hosts like Render/Railway/Heroku wipe the disk on every deploy, so images saved to
# uploads/ would disappear. Leave blank in local development and images are saved to backend/uploads/ instead.
# Cloudinary dashboard -> "API Keys" shows the value; use EITHER the single URL...
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# ...or the three separate variables:
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# Folder inside your Cloudinary account (default aurelia/products). Only images in this folder are ever deleted by the app.
# CLOUDINARY_FOLDER=aurelia/products

# ---- Shipping and returns (optional) ----
# One place to change these; the website reads them from GET /api/config, so no frontend edit is needed.
# Defaults shown. Restart the server after changing.
# FREE_SHIPPING_THRESHOLD=15000   # subtotal at or above this ships free (Rs)
# SHIPPING_FEE=350                # flat fee below the threshold (Rs)
# RETURN_WINDOW_DAYS=14           # days after delivery a customer can request a return

# Admin images that were uploaded but never saved to a product are deleted after this many hours (default 24).
# UPLOAD_MAX_AGE_HOURS=24

# Secret used to sign the unsubscribe links that go into newsletter emails. Set it once and never change it:
# changing it makes every link in emails you already sent stop working. Falls back to JWT_SECRET if blank
# (then rotating JWT_SECRET breaks old unsubscribe links too).
# UNSUBSCRIBE_SECRET=replace-with-another-long-random-string

# ---- Email (order confirmations, shipping updates, password reset, newsletter welcome) ----
# Without SMTP_HOST + MAIL_FROM nothing is sent: in development the email is printed in the server console
# (handy: you can copy a password-reset link from there), in production a warning is logged.
# Gmail:  SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_USER=you@gmail.com  SMTP_PASS=<16-character App Password>
# Brevo (free tier) / Resend / SendGrid / Mailgun all give you SMTP details in the same shape.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false          # "true" for port 465
# MAIL_FROM="Aurelia <hello@yourdomain.com>"   # must be an address your mail provider allows you to send from

# Where new-order, return and contact-form alerts go. Falls back to ADMIN_EMAIL if blank.
# ADMIN_NOTIFY_EMAIL=

# Admin dashboard (optional). The store's time zone decides what counts as "today"; low stock = this many units or fewer.
# STORE_TIMEZONE=Asia/Karachi
# LOW_STOCK_THRESHOLD=5

# ---- Error tracking (Sentry) — optional, see docs/OPERATIONS.md ----
# Create a free project at sentry.io (platform: Node.js / Express), paste its DSN here, then `npm install @sentry/node`.
# Leave blank to turn error tracking off. The DSN is not a password, but keep it in the environment anyway.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production          # shown in Sentry so staging and live errors are kept apart
# SENTRY_RELEASE=                        # optional: e.g. a git commit id, to see which deploy introduced an error
# SENTRY_TRACES_SAMPLE_RATE=0            # performance tracing, 0 = off (default). 0.1 = 10% of requests

# ---- Database backups (npm run backup) ----
# BACKUP_DIR=./backups                   # where backup folders are written (keep it OUTSIDE any public folder)
# BACKUP_KEEP=14                         # how many recent backups to keep; 0 = never delete old ones

# ---- Online payment: PayFast Pakistan (card / mobile wallet) ----
# Without these the "Card" option at checkout answers "online payment isn't available" and cash on delivery keeps working.
# Get the merchant id and secured key from your PayFast (APPS / GoPayFast) merchant dashboard. Keep the key SECRET.
# Start in sandbox with the test credentials PayFast gives you, and only switch to live after a full test payment.
# PAYFAST_MERCHANT_ID=
# PAYFAST_SECURED_KEY=
# PAYFAST_MERCHANT_NAME=Aurelia          # shown to the customer on the PayFast page
# PAYFAST_STORE_ID=                      # only if PayFast gave you one
# PAYFAST_ENV=sandbox                    # "sandbox" (default) or "live"
# PAYFAST_BASE_URL=                      # only to override PayFast's address (sandbox / live addresses are built in)
# The PUBLIC https address of THIS backend: PayFast calls <BACKEND_URL>/api/payments/payfast/ipn after each payment.
# It must be reachable from the internet (on your computer use a tunnel such as ngrok).
# BACKEND_URL=https://api.yourdomain.com
# ---- Online payment: JazzCash (mobile account) ----
# Without these the "JazzCash" option at checkout answers "online payment isn't available" and the other methods keep working.
# Get the merchant id, API password and integrity salt from your JazzCash merchant portal. Keep the password and salt SECRET.
# Start in sandbox with JazzCash's test credentials; only switch to live after a full test payment.
# JAZZCASH_MERCHANT_ID=
# JAZZCASH_PASSWORD=
# JAZZCASH_INTEGRITY_SALT=
# JAZZCASH_ENV=sandbox                   # "sandbox" (default) or "live"
# JAZZCASH_TXN_TYPE=MWALLET              # MWALLET (JazzCash account, default), MPAY, OTC, or ALL to let the customer choose
# JAZZCASH_BASE_URL=                     # only to override the payment form address
# In the JazzCash portal the return address is sent with every payment (<BACKEND_URL>/api/payments/jazzcash/return).
# If the portal asks for an IPN address too, use <BACKEND_URL>/api/payments/jazzcash/ipn

# ---- Online payment: Easypaisa (Easypay) ----
# Without these the "Easypaisa" option at checkout answers "online payment isn't available" and the other methods keep working.
# Everything comes from your Easypay merchant portal / integration kit. Keep the hash key and password SECRET.
# EASYPAISA_STORE_ID=
# EASYPAISA_HASH_KEY=                    # 16 characters
# EASYPAISA_ACCOUNT_NUM=                 # the Easypaisa account the money lands in
# EASYPAISA_USERNAME=                    # API credentials, used to ask Easypay "was this order paid?"
# EASYPAISA_PASSWORD=
# EASYPAISA_ENV=sandbox                  # "sandbox" (default) or "live"
# EASYPAISA_PAYMENT_METHOD=MA_PAYMENT_METHOD   # MA_PAYMENT_METHOD (Easypaisa account, default), CC_PAYMENT_METHOD (card), OTC_PAYMENT_METHOD, or ALL
# EASYPAISA_BASE_URL=                    # only to override Easypay's address
# Easypay sends the customer back to <BACKEND_URL>/api/payments/easypaisa/return. If the portal asks for an IPN address
# too, use <BACKEND_URL>/api/payments/easypaisa/ipn  (the shop never trusts the message itself, it asks Easypay).
# BACKEND_URL (above) is shared by all three gateways.

# An online order that is still unpaid after this many minutes is cancelled and its stock put back (default 60, minimum 10).
# PAYMENT_HOLD_MINUTES=60
